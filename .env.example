# ---------------------------------------------------------------------------
# Copy to .env.local and fill in what you need. .env.local is gitignored.
#
# Everything here is OPTIONAL. The app runs fully with none of it set:
# resumes, roadmaps and deadlines are local-first, and the regex parser is offline.
# Add only the groups whose features you actually want.
# ---------------------------------------------------------------------------

# === Sign-in (Firebase Auth, browser) =========================================
# From Firebase console -> Project settings -> Your apps -> SDK setup.
# Then Authentication -> Sign-in method -> enable "Google".
# Without these, /login and /signup say so plainly and the app carries on working.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === Shared experiences (server) ==============================================
# Firebase service account: Project settings -> Service accounts -> Generate new
# private key. This is a full read/write credential on the database — treat it as a
# database password and never commit it.
# (admin.js converts the literal \n escapes that hosting providers store.)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gemini key for the experience reviewer and the Ask AI endpoint. Server-side only.
# Get one at https://aistudio.google.com/apikey
# This is a SEPARATE key from NEXT_PUBLIC_GEMINI_API_KEY below.
GEMINI_API_KEY=

# Comma-separated Firebase uids allowed to open the review queue and approve or
# reject submissions. Without your own uid here you cannot moderate anything.
ADMIN_UIDS=

# Shared secret that the Google Apps Script webhook sends in the x-ingest-secret
# header. Generate with: openssl rand -hex 32
INGEST_SECRET=

# === Resume camera scan (browser) ==============================================
# This key IS bundled into the browser. Don't reuse a key you care about.
# Students can also paste their own key into the camera window instead, which is
# stored on their device only and needs no env var here.
NEXT_PUBLIC_GEMINI_API_KEY=

# === Optional overrides =======================================================

# First model to try, then a built-in fallback chain. The list rots as Google
# retires models — check GET /v1beta/models?key=... before trusting it.
NEXT_PUBLIC_GEMINI_MODEL=

# Only for a proxy or a regional endpoint.
NEXT_PUBLIC_GEMINI_BASE_URL=

# Only needed if the app is served from a sub-path.
NEXT_PUBLIC_BASE_PATH=

# Where the mock-interview backend runs. It is a separate process: `npm run backend`.
NEXT_PUBLIC_INTERVIEW_API=http://localhost:3001
